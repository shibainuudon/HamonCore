<?xml version="1.0" encoding="utf-8"?>

<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="hamon::inplace_vector&lt;*,*&gt;">
		<Intrinsic Name="size" Expression="(size_t)(m_size)" />
		<DisplayString>{{ size={size()} }}</DisplayString>
		<Expand>
			<ArrayItems>
				<Size>size()</Size>
				<ValuePointer>m_value</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="hamon::detail::inplace_vector_iterator&lt;*,*,*&gt;">
		<SmartPointer Usage="Indexable">m_begin+m_offset,na</SmartPointer>
		<Expand>
			<Item Name="[ptr]">m_begin+m_offset</Item>
		</Expand>
	</Type>
</AutoVisualizer>
